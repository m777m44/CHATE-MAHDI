# Base URL of the backend API (the mobile app defaults to http://10.0.2.2:4000/api
# inside the Android emulator; use https://YOUR-DOMAIN/api in production).
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatemahdi?schema=public

# JWT secrets (use long random strings)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Storage: local disk by default (served at /uploads), or cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
