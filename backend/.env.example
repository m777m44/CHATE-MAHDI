# CHATE-MAHDI backend environment
NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose creates a 'chatemahdi' database)
DATABASE_URL="postgresql://chatemahdi:chatemahdi@localhost:5432/chatemahdi?schema=public"

# JWT secrets - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage driver: "local" (default, files served from backend/uploads)
# or "cloudinary" (uses the keys below)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS origins allowed to call the API (comma separated, * for all in dev)
CORS_ORIGINS=*
